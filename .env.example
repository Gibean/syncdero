# SYNCDERO - Plantilla de variables de entorno para docker-compose.
# Copie a .env y ajuste:  cp .env.example .env
# .env está en .gitignore: jamás versionar credenciales reales.
# docker-compose exige estas variables definidas (no hay fallbacks hardcodeados).

# Contraseña de autorización para aplicar migraciones en entornos protegidos
SYNCDERO_APPLY_PASSWORD=cambiar_esta_clave

# Modo de Operación: false = Standalone (desarrollador individual multi-proyecto, sin login)
#                   true  = Modo Equipo (con RBAC, login y aislamiento de espejos)
SYNCDERO_TEAM_MODE=false

# Clave de encriptación de sesiones (32 caracteres o base64 para Laravel Illuminate)
SYNCDERO_APP_KEY=32_caracteres_aleatorios_clave!!

# Entorno de referencia principal (Master) que sirve de origen para espejos de desarrolladores
SYNCDERO_REFERENCE_ENV=pg_main

# Conexión MariaDB/MySQL
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=app_db
MARIADB_USER=root
MARIADB_PASSWORD=cambiar_esta_clave

# Conexión PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_DATABASE=app_db
PG_PASSWORD=cambiar_esta_clave
