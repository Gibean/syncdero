#!/usr/bin/env php
<?php

declare(strict_types=1);

// SYNCDERO CLI Runner
// Compatible con PHP 8.2+ en Windows, Linux y Docker

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../src/autoload.php',
];

$loaded = false;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require_once $path;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Error: No se pudo cargar el autoloader de SYNCDERO.\n");
    exit(1);
}

use Syncdero\Core\Config;
use Syncdero\Core\StateEngine;
use Syncdero\Drivers\DriverFactory;

Config::loadEnv(__DIR__ . '/../.env');

$configPath = getenv('SYNCDERO_CONFIG') ?: (__DIR__ . '/../config/syncdero.php');
if (!file_exists($configPath)) {
    // Si no existe, revisar en public/config.php legacy
    $configPath = __DIR__ . '/../public/config.php';
}

$config = Config::load($configPath);
$stateEngine = new StateEngine($config->getMigrationsDir(), $config->getRepoDir());

$args = array_slice($argv, 1);
$command = $args[0] ?? 'status';

function printHeader(): void {
    echo "\033[1;36m";
    echo "========================================================\n";
    echo "  SYNCDERO - Git-Like Database Version Control v1.0.0   \n";
    echo "========================================================\n";
    echo "\033[0m";
}

function printHelp(): void {
    printHeader();
    echo "Uso:\n";
    echo "  php bin/syncdero <comando> [opciones]\n\n";
    echo "Comandos disponibles:\n";
    echo "  \033[1;32mstatus\033[0m     Muestra el estado de sincronización de todos los entornos.\n";
    echo "             Opciones: --fail-on-divergence, --format=json\n";
    echo "  \033[1;32msync\033[0m       Aplica las migraciones pendientes en un entorno específico.\n";
    echo "             Uso: php bin/syncdero sync <entorno> [--dry-run] [--no-backup]\n";
    echo "  \033[1;32mdiff\033[0m       Muestra el diff y contenido de migraciones pendientes o conflictivas.\n";
    echo "             Uso: php bin/syncdero diff <entorno>\n";
    echo "             Compara dos entornos: php bin/syncdero diff <entornoA> <entornoB>\n";
    echo "  \033[1;32mbackup\033[0m     Genera un snapshot manual del entorno indicado.\n";
    echo "             Uso: php bin/syncdero backup <entorno>\n";
    echo "  \033[1;32mrestore\033[0m    Restaura un snapshot de respaldo en el entorno indicado.\n";
    echo "             Uso: php bin/syncdero restore <entorno> [--file=<archivo>]\n";
    echo "  \033[1;32mrollback\033[0m   Deshace los cambios recientes restaurando el snapshot más reciente.\n";
    echo "             Uso: php bin/syncdero rollback <entorno>\n";
    echo "  \033[1;32mbranch\033[0m     Crea una rama (copia de esquema) de un entorno como nueva base de datos.\n";
    echo "             Uso: php bin/syncdero branch <entorno> <nombre> [--with-data]\n\n";
}

// Ejecución de comandos
switch ($command) {
    case 'help':
    case '--help':
    case '-h':
        printHelp();
        exit(0);

    case 'status':
        $failOnDivergence = in_array('--fail-on-divergence', $args, true);
        $asJson = in_array('--format=json', $args, true);

        $results = [];
        $hasAnyDivergence = false;
        $environments = $config->getEnvironments();

        foreach ($environments as $envKey => $envConfig) {
            try {
                $driver = DriverFactory::create($envConfig);
                $connected = $driver->testConnection();

                if (!$connected) {
                    $results[$envKey] = [
                        'status' => 'DISCONNECTED',
                        'error' => 'No se pudo conectar a la base de datos',
                    ];
                    continue;
                }

                $inspection = $stateEngine->inspectEnvironment($driver);
                if ($inspection['has_divergence']) {
                    $hasAnyDivergence = true;
                }

                $results[$envKey] = [
                    'label' => $envConfig['label'] ?? $envKey,
                    'driver' => $driver->getName(),
                    'role' => $envConfig['role'] ?? 'dev',
                    'is_synced' => $inspection['is_synced'],
                    'has_divergence' => $inspection['has_divergence'],
                    'total_disk' => $inspection['total_disk'],
                    'total_applied' => $inspection['total_applied'],
                    'pending_count' => count($inspection['pending']),
                    'divergent_count' => count($inspection['divergent']),
                    'pending' => array_keys($inspection['pending']),
                    'divergent' => array_keys($inspection['divergent']),
                ];
            } catch (\Throwable $e) {
                $results[$envKey] = [
                    'status' => 'ERROR',
                    'error' => $e->getMessage(),
                ];
            }
        }

        if ($asJson) {
            echo json_encode(['syncdero' => $results], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        } else {
            printHeader();
            $git = $stateEngine->getGitInfo();
            echo "Git Branch: \033[1;33m{$git['branch']}\033[0m | Commit: \033[1;33m{$git['commit']}\033[0m\n";
            echo "Directorio de migraciones: \033[0;37m" . $config->getMigrationsDir() . "\033[0m\n\n";

            printf("%-18s %-10s %-12s %-10s %-12s %s\n", "ENTORNO", "DRIVER", "ROL", "APLICADAS", "PENDIENTES", "ESTADO");
            echo str_repeat("-", 75) . "\n";

            foreach ($results as $envKey => $res) {
                if (isset($res['error'])) {
                    printf("%-18s %-10s %-12s %-10s %-12s \033[1;31m%s\033[0m\n", $envKey, "-", "-", "-", "-", "ERROR: " . $res['error']);
                    continue;
                }

                $statusStr = "\033[1;32mSINCRONIZADO\033[0m";
                if ($res['has_divergence']) {
                    $statusStr = "\033[1;31mCONFLICTO (DIVERGENTE)\033[0m";
                } elseif ($res['pending_count'] > 0) {
                    $statusStr = "\033[1;33mATRASADO (-{$res['pending_count']})\033[0m";
                }

                printf(
                    "%-18s %-10s %-12s %-10s %-12s %s\n",
                    $envKey,
                    $res['driver'],
                    strtoupper($res['role']),
                    $res['total_applied'] . "/" . $res['total_disk'],
                    $res['pending_count'],
                    $statusStr
                );
            }
            echo "\n";
        }

        if ($failOnDivergence && $hasAnyDivergence) {
            fwrite(STDERR, "\033[1;31m[ERROR CI/CD] Se detectaron divergencias de hash en las bases de datos.\033[0m\n");
            exit(1);
        }
        exit(0);

    case 'sync':
        $targetEnv = $args[1] ?? null;
        if (!$targetEnv) {
            fwrite(STDERR, "\033[1;31mError: Debe especificar el entorno a sincronizar. Ej: php bin/syncdero sync mariadb_local\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($targetEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$targetEnv}' no encontrado en la configuración.\033[0m\n");
            exit(1);
        }

        $dryRun = in_array('--dry-run', $args, true);
        $noBackup = in_array('--no-backup', $args, true);

        printHeader();
        echo "Iniciando sincronización para: \033[1;33m{$targetEnv}\033[0m\n";

        $driver = DriverFactory::create($envConfig);
        $inspection = $stateEngine->inspectEnvironment($driver);

        if ($inspection['has_divergence']) {
            fwrite(STDERR, "\033[1;31mABORTANDO: El entorno tiene migraciones con hash divergente (archivos modificados).\033[0m\n");
            exit(1);
        }

        $pending = $inspection['pending'];
        if (empty($pending)) {
            echo "\033[1;32m¡La base de datos ya está completamente al día! No hay pendientes.\033[0m\n";
            exit(0);
        }

        echo "Migraciones pendientes a aplicar: " . count($pending) . "\n";
        foreach ($pending as $item) {
            echo "  - {$item['file']->filename} (" . strtoupper($item['file']->type) . ")\n";
        }

        if ($dryRun) {
            echo "\033[1;36m[DRY RUN] Simulación finalizada. Ningún cambio fue ejecutado.\033[0m\n";
            exit(0);
        }

        // Crear respaldo automático previo
        if (!$noBackup) {
            echo "Creando respaldo de seguridad previo...";
            $backupRes = $driver->createBackup($config->getBackupDir());
            if ($backupRes['success']) {
                echo " \033[1;32mOK\033[0m ({$backupRes['path']})\n";
            } else {
                echo " \033[1;33mAVISO: {$backupRes['message']}\033[0m\n";
            }
        }

        echo "Aplicando lote de migraciones...\n";
        $syncResult = $stateEngine->syncPending($driver, $pending, 'cli_user');

        if ($syncResult['success']) {
            echo "\033[1;32m✓ Sincronización exitosa: {$syncResult['applied_count']} migraciones en {$syncResult['duration_ms']}ms (Batch #{$syncResult['batch']})\033[0m\n";
            exit(0);
        } else {
            fwrite(STDERR, "\033[1;31m✗ Falló la migración: " . json_encode($syncResult['errors']) . "\033[0m\n");
            exit(1);
        }

    case 'backup':
        $targetEnv = $args[1] ?? null;
        if (!$targetEnv) {
            fwrite(STDERR, "\033[1;31mError: Debe especificar el entorno. Ej: php bin/syncdero backup sqlite_demo\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($targetEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$targetEnv}' no encontrado en la configuración.\033[0m\n");
            exit(1);
        }

        printHeader();
        echo "Generando snapshot manual de: \033[1;33m{$targetEnv}\033[0m\n";

        $driver = DriverFactory::create($envConfig);
        if (!$driver->testConnection()) {
            fwrite(STDERR, "\033[1;31mError: No se pudo conectar a la base de datos.\033[0m\n");
            exit(1);
        }

        $backupRes = $driver->createBackup($config->getBackupDir());
        if ($backupRes['success']) {
            echo "\033[1;32m✓ Snapshot generado: {$backupRes['path']}\033[0m\n";
            exit(0);
        }
        fwrite(STDERR, "\033[1;31m✗ {$backupRes['message']}\033[0m\n");
        exit(1);

    case 'restore':
        $targetEnv = $args[1] ?? null;
        if (!$targetEnv) {
            fwrite(STDERR, "\033[1;31mError: Debe especificar el entorno. Ej: php bin/syncdero restore sqlite_demo\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($targetEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$targetEnv}' no encontrado.\033[0m\n");
            exit(1);
        }

        $fileArg = null;
        foreach ($args as $a) {
            if (str_starts_with((string) $a, '--file=')) {
                $fileArg = substr((string) $a, 7);
            }
        }

        printHeader();
        echo "Restauración de snapshot en: \033[1;33m{$targetEnv}\033[0m\n";

        $driver = DriverFactory::create($envConfig);
        if (!$driver->testConnection()) {
            fwrite(STDERR, "\033[1;31mError: No se pudo conectar a la base de datos.\033[0m\n");
            exit(1);
        }

        // Resolver el archivo a restaurar: explícito o el más reciente del entorno
        if ($fileArg !== null && $fileArg !== '') {
            $backupFile = is_file($fileArg)
                ? realpath($fileArg)
                : $config->getBackupDir() . DIRECTORY_SEPARATOR . basename($fileArg);
        } else {
            $backupFile = $stateEngine->findLatestBackup($config->getBackupDir(), (string) ($envConfig['database'] ?? ''));
            if ($backupFile === null) {
                fwrite(STDERR, "\033[1;31mNo hay snapshots disponibles para '{$targetEnv}'. Ejecute 'php bin/syncdero backup {$targetEnv}' primero.\033[0m\n");
                exit(1);
            }
        }

        if (!is_string($backupFile) || !file_exists((string) $backupFile)) {
            fwrite(STDERR, "\033[1;31mError: El archivo de respaldo indicado no existe.\033[0m\n");
            exit(1);
        }

        echo "Snapshot objetivo: \033[0;37m" . basename((string) $backupFile) . "\033[0m\n";

        echo "Creando respaldo de seguridad previo...";
        $safety = $driver->createBackup($config->getBackupDir());
        echo $safety['success']
            ? " \033[1;32mOK\033[0m ({$safety['path']})\n"
            : " \033[1;33mAVISO: {$safety['message']}\033[0m\n";

        echo "Restaurando...\n";
        $res = $driver->restoreBackup((string) $backupFile);

        if ($res['success']) {
            echo "\033[1;32m✓ Restauración exitosa:\033[0m {$res['message']}\n";
            if (!empty($res['rewound'])) {
                echo "Migraciones rebobinadas al estado del snapshot:\n";
                foreach ($res['rewound'] as $m) {
                    echo "  - {$m}\n";
                }
            } else {
                echo "El estado de versionado coincide con el snapshot (nada rebobinado).\n";
            }
            exit(0);
        }
        fwrite(STDERR, "\033[1;31m✗ {$res['message']}\033[0m\n");
        exit(1);

    case 'rollback':
        $targetEnv = $args[1] ?? null;
        if (!$targetEnv) {
            fwrite(STDERR, "\033[1;31mError: Debe especificar el entorno para rollback. Ej: php bin/syncdero rollback sqlite_demo\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($targetEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$targetEnv}' no encontrado.\033[0m\n");
            exit(1);
        }

        printHeader();
        echo "Ejecutando Rollback (restauración del snapshot más reciente) en: \033[1;33m{$targetEnv}\033[0m\n";

        $driver = DriverFactory::create($envConfig);
        if (!$driver->testConnection()) {
            fwrite(STDERR, "\033[1;31mError: No se pudo conectar a la base de datos.\033[0m\n");
            exit(1);
        }

        $rbResult = $stateEngine->rollbackToLatestBackup($driver, $config->getBackupDir(), (string) ($envConfig['database'] ?? ''));

        if ($rbResult['success']) {
            echo "Snapshot restaurado: \033[0;37m" . basename((string) $rbResult['restored_from']) . "\033[0m\n";
            if (!empty($rbResult['safety_path'])) {
                echo "Respaldo de seguridad previo: \033[0;37m" . basename($rbResult['safety_path']) . "\033[0m\n";
            }
            echo "\033[1;32m✓ Rollback exitoso:\033[0m {$rbResult['message']}\n";
            if (!empty($rbResult['rewound'])) {
                echo "Migraciones rebobinadas:\n";
                foreach ($rbResult['rewound'] as $m) {
                    echo "  - {$m}\n";
                }
            }
            exit(0);
        }
        fwrite(STDERR, "\033[1;31m✗ {$rbResult['message']}\033[0m\n");
        exit(1);

    case 'diff':
        $targetEnv = $args[1] ?? null;
        if (!$targetEnv) {
            fwrite(STDERR, "\033[1;31mError: Debe especificar el entorno para diff. Ej: php bin/syncdero diff mariadb_local\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($targetEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$targetEnv}' no encontrado en la configuración.\033[0m\n");
            exit(1);
        }

        // Modo comparación entre dos entornos: diff <entornoA> <entornoB>
        $secondEnv = null;
        foreach (array_slice($args, 2) as $a) {
            $a = (string) $a;
            if ($a !== '' && !str_starts_with($a, '--')) {
                $secondEnv = $a;
                break;
            }
        }

        if ($secondEnv !== null) {
            $envBConfig = $config->getEnvironment($secondEnv);
            if (!$envBConfig) {
                fwrite(STDERR, "\033[1;31mError: Entorno '{$secondEnv}' no encontrado en la configuración.\033[0m\n");
                exit(1);
            }

            printHeader();
            echo "Comparación de estados entre \033[1;33m{$targetEnv}\033[0m y \033[1;33m{$secondEnv}\033[0m\n\n";

            $driverA = DriverFactory::create($envConfig);
            if (!$driverA->testConnection()) {
                fwrite(STDERR, "\033[1;31mError: No se pudo conectar a '{$targetEnv}'.\033[0m\n");
                exit(1);
            }
            $driverB = DriverFactory::create($envBConfig);
            if (!$driverB->testConnection()) {
                fwrite(STDERR, "\033[1;31mError: No se pudo conectar a '{$secondEnv}'.\033[0m\n");
                exit(1);
            }

            $appliedA = $driverA->getAppliedMigrations();
            $appliedB = $driverB->getAppliedMigrations();

            $onlyInA = array_diff_key($appliedA, $appliedB);
            $onlyInB = array_diff_key($appliedB, $appliedA);
            $hashConflicts = [];
            foreach ($appliedA as $name => $rowA) {
                if (isset($appliedB[$name]) && $appliedB[$name]['hash'] !== $rowA['hash']) {
                    $hashConflicts[$name] = ['a' => $rowA['hash'], 'b' => $appliedB[$name]['hash']];
                }
            }

            echo "Aplicadas en {$targetEnv}: " . count($appliedA) . " | Aplicadas en {$secondEnv}: " . count($appliedB) . "\n\n";

            if (!empty($onlyInA)) {
                echo "\033[1;33m=== APLICADAS EN {$targetEnv} PERO NO EN {$secondEnv} (pendientes en {$secondEnv}) ===\033[0m\n";
                foreach ($onlyInA as $name => $row) {
                    echo "  - {$name} (Batch #{$row['batch']}, aplicada {$row['applied_at']})\n";
                }
                echo "\n";
            }

            if (!empty($onlyInB)) {
                echo "\033[1;33m=== APLICADAS EN {$secondEnv} PERO NO EN {$targetEnv} (pendientes en {$targetEnv}) ===\033[0m\n";
                foreach ($onlyInB as $name => $row) {
                    echo "  - {$name} (Batch #{$row['batch']}, aplicada {$row['applied_at']})\n";
                }
                echo "\n";
            }

            if (!empty($hashConflicts)) {
                echo "\033[1;31m=== CONFLICTOS DE HASH ENTRE ENTORNOS (misma migración, contenido distinto) ===\033[0m\n";
                foreach ($hashConflicts as $name => $h) {
                    echo "  Archivo: \033[1;37m{$name}\033[0m\n";
                    echo "    Hash en {$targetEnv}:  {$h['a']}\n";
                    echo "    Hash en {$secondEnv}:  {$h['b']}\n";
                }
                echo "\n";
            }

            if (empty($onlyInA) && empty($onlyInB) && empty($hashConflicts)) {
                echo "\033[1;32mAmbos entornos tienen aplicado exactamente el mismo conjunto de migraciones (hashes incluidos).\033[0m\n";
                exit(0);
            }

            if (!empty($hashConflicts)) {
                fwrite(STDERR, "\033[1;31mDivergencia entre entornos detectada: " . count($hashConflicts) . " migración(es) con hash distinto.\033[0m\n");
                exit(1);
            }
            exit(0);
        }

        printHeader();
        $driver = DriverFactory::create($envConfig);
        $inspection = $stateEngine->inspectEnvironment($driver);

        echo "Inspector de Cambios para \033[1;33m{$targetEnv}\033[0m:\n\n";

        if (!empty($inspection['divergent'])) {
            echo "\033[1;31m=== DIVERGENCIAS DETECTADAS (DRIFT) ===\033[0m\n";
            foreach ($inspection['divergent'] as $name => $item) {
                echo "Archivo: \033[1;37m{$name}\033[0m\n";
                echo "  Hash en BD:    {$item['db']['hash']}\n";
                echo "  Hash en disco: {$item['file']->hash}\n";
                echo "  Estado: Archivo en disco modificado posteriormente a su aplicación.\n\n";
            }
        }

        if (!empty($inspection['pending'])) {
            echo "\033[1;33m=== MIGRACIONES PENDIENTES (UNSTAGED) ===\033[0m\n";
            foreach ($inspection['pending'] as $item) {
                $file = $item['file'];
                echo "--------------------------------------------------------\n";
                echo "Archivo: \033[1;32m{$file->filename}\033[0m (SHA: {$file->hash})\n";
                echo "--------------------------------------------------------\n";
                $preview = substr($file->getContent(), 0, 500);
                echo $preview . (strlen($file->getContent()) > 500 ? "\n... [truncado]" : "") . "\n\n";
            }
        }

        if (empty($inspection['divergent']) && empty($inspection['pending'])) {
            echo "\033[1;32mNo hay diferencias. El entorno está 100% sincronizado con el disco.\033[0m\n";
        }
        exit(0);

    case 'branch':
        $sourceEnv = $args[1] ?? null;
        $branchName = $args[2] ?? null;
        if (!$sourceEnv || !$branchName) {
            fwrite(STDERR, "\033[1;31mError: Uso: php bin/syncdero branch <entorno> <nombre> [--with-data]\033[0m\n");
            exit(1);
        }

        $envConfig = $config->getEnvironment($sourceEnv);
        if (!$envConfig) {
            fwrite(STDERR, "\033[1;31mError: Entorno '{$sourceEnv}' no encontrado en la configuración.\033[0m\n");
            exit(1);
        }

        $slug = strtolower((string) preg_replace('/[^a-zA-Z0-9_-]+/', '_', trim($branchName)));
        $slug = trim($slug, '_');
        if ($slug === '' || strlen($slug) > 63) {
            fwrite(STDERR, "\033[1;31mError: Nombre de rama inválido tras sanear (usa letras, números, guiones).\033[0m\n");
            exit(1);
        }

        $withData = in_array('--with-data', $args, true);

        printHeader();
        echo "Creando rama \033[1;35m{$slug}\033[0m desde \033[1;33m{$sourceEnv}\033[0m" . ($withData ? " (con datos)" : " (solo esquema)") . "\n\n";

        if ($config->getEnvironment($slug) !== null) {
            fwrite(STDERR, "\033[1;31mError: Ya existe un entorno llamado '{$slug}' en la configuración.\033[0m\n");
            exit(1);
        }

        $driver = DriverFactory::create($envConfig);
        if (!$driver->testConnection()) {
            fwrite(STDERR, "\033[1;31mError: No se pudo conectar al entorno de origen '{$sourceEnv}'.\033[0m\n");
            exit(1);
        }

        $isSqlite = ($envConfig['driver'] ?? '') === 'sqlite';

        // Garantiza que el origen tenga historial de versionado que heredar
        $driver->ensureMetadataTable();

        if (!$isSqlite) {
            echo "Creando base de datos destino '{$slug}'...";
            $driver->createDatabase($slug);
            echo " \033[1;32mOK\033[0m\n";
        }

        echo "Copiando esquema" . ($withData ? " y datos" : "") . "...";
        $driver->copySchemaTo($slug, $withData);
        echo " \033[1;32mOK\033[0m\n";

        $branchConfig = $envConfig;
        unset($branchConfig['is_discovered'], $branchConfig['server_key'], $branchConfig['label']);
        $branchConfig['label'] = 'Rama ' . $branchName . ' (de ' . ($envConfig['label'] ?? $sourceEnv) . ')';
        $branchConfig['role'] = 'dev';
        $branchConfig['protected'] = false;
        $branchConfig['branch_of'] = $sourceEnv;
        $branchConfig['color'] = '#a855f7';
        if ($isSqlite) {
            $branchConfig['database'] = rtrim(dirname((string) $envConfig['database']), '/\\')
                . DIRECTORY_SEPARATOR . $slug . '.sqlite';
        } else {
            $branchConfig['database'] = $slug;
        }

        echo "Registrando entorno en la configuración...";
        $config->addEnvironment($slug, $branchConfig, $configPath);
        echo " \033[1;32mOK\033[0m\n";

        echo "\n\033[1;32m✓ Rama creada: \033[0mLa base de datos '{$slug}' replica el historial de versionado de '{$sourceEnv}'.\n";
        echo "Ahora aparece como entorno en 'status' y en el dashboard: \033[0;37mphp bin/syncdero status\033[0m\n";
        exit(0);

    default:
        fwrite(STDERR, "Comando desconocido: '{$command}'. Ejecute 'php bin/syncdero --help' para ayuda.\n");
        exit(1);
}
